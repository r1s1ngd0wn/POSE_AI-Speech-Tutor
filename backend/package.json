{
  "name": "ai-speaking-tutor-backend",
  "version": "0.1.0",
  "description": "AI Speaking Tutor backend API: auth, child profiles, AI-generated lessons, rule-based scoring, learner model, reports, privacy controls, teacher review and speech",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/*.test.js\"",
    "seed:auth": "node scripts/seedSupabaseUser.js",
    "bootstrap:admins": "node scripts/bootstrapAdmins.js",
    "try:lessons": "node scripts/tryLessons.js",
    "try:report": "node scripts/tryReport.js",
    "eval:stt": "node scripts/evalStt.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-pgvector": "^0.0.12"
  },
  "overrides": {
    "body-parser": "1.20.9"
  }
}
