# ---------------------------------------------------------------------------------------------------
# AI Speaking Tutor backend. Copy to backend/.env. Never commit real values.
# ---------------------------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (1 with the bundled nginx), so rate limits see real client IPs.
TRUST_PROXY=

# --- Database and sign-in (Supabase) --------------------------------------------------------------------
# Supabase Session pooler or Direct Postgres connection. Backend only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. A new Supabase Secret key also works as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# Explicit CLI setup only (npm run seed:auth, npm run bootstrap:admins). No persistent test users on startup.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
ADMIN_EMAILS=
# Nonproduction local preview only (in-memory, nothing persists; seeds parent@tutor.test and teacher@tutor.test,
# password "password123"):
# STORE_BACKEND=memory

# --- Parent PIN ----------------------------------------------------------------------------------------
# Secret that signs the short-lived parent PIN tokens. Set a long random value in every deployment; without it
# each server process uses a random secret and tokens do not work across processes.
TUTOR_PIN_SECRET=

# --- Lesson and report generation (language model) --------------------------------------------------------
# Nothing is used unless TUTOR_LLM_PROVIDER is set; without it the tutor serves its vetted fallback lessons.
#   local       an OpenAI-compatible server on your machine (LM Studio, Ollama, llama.cpp): free, nothing leaves it
#   openrouter  needs the two settings below. Pin one exact model id from openrouter.ai/models and check that
#               model's data policy before real children use it.
TUTOR_LLM_PROVIDER=
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# true routes only to zero-data-retention endpoints (may reduce the available models).
OPENROUTER_ZDR=
# Default 20000 for openrouter, 90000 for local.
TUTOR_LLM_TIMEOUT_MS=

# --- Speech, server side (optional; unset means the browser does speech) --------------------------------
# Which provider is acceptable for children's voices has NOT been verified: check its data policy and run
# `npm run eval:stt -- <folder>` on permitted samples before choosing one.
#   TUTOR_STT_PROVIDER = xai | groq        TUTOR_TTS_PROVIDER = xai
TUTOR_STT_PROVIDER=
TUTOR_TTS_PROVIDER=
XAI_API_KEY=
GROQ_API_KEY=
TUTOR_TTS_VOICE=
# true lets Groq's rough log-probability confidence count towards the Clarity score (uncalibrated; leave off).
TUTOR_STT_USE_LOGPROB=
