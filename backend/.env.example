PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=
# Supabase Session pooler or Direct Postgres connection. Backend only.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. A new Supabase Secret key also works as SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_PROVIDER=gemini
# Optional: record answers and transcribe them with Groq's hosted Whisper instead of the browser's
# speech recogniser (better with accents). Audio is sent to Groq; leave empty to keep browser speech.
GROQ_API_KEY=
LLM_TIMEOUT_MS=15000
GEMINI_THINKING_BUDGET=0
LLM_REACTIONS=on
# Providers in the order they are tried: local,gemini (Gemma first, Gemini when it fails), local,
# gemini, or none to disable generation even if a key is present.
LLM_PROVIDER=gemini
RAG_MATCH_THRESHOLD=0.72
RAG_PREP_THRESHOLD=0.5
# Explicit CLI setup only. No automatic persistent test users on startup.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
ADMIN_EMAILS=
# Nonproduction local preview only (in-memory; no upload or persistence):
# STORE_BACKEND=memory

# Structured review and optional per-provider retrieval calibration.
LLM_CRITIQUE=on
RAG_MATCH_THRESHOLD_GEMINI=
RAG_MATCH_THRESHOLD_LOCAL=
# Local LLM (LM Studio and other OpenAI-compatible servers). Embeddings stay on Gemini.
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LOCAL_EMBEDDING_MODEL=

# AI Speaking Tutor lesson generation (separate from the InterviewAI LLM settings above).
# Nothing is used unless TUTOR_LLM_PROVIDER is set; without it the tutor serves its vetted fallback lessons.
#   local       uses LOCAL_LLM_URL / LOCAL_LLM_MODEL above (LM Studio etc.): free, nothing leaves your machine
#   openrouter  needs the two settings below. Pin one exact model id from openrouter.ai/models and check
#               that model's data policy before real children use it.
TUTOR_LLM_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Set to true to route only to zero-data-retention endpoints (may reduce the available models).
OPENROUTER_ZDR=
# Default 20000 for openrouter, 90000 for local.
TUTOR_LLM_TIMEOUT_MS=

# Secret that signs the short-lived parent PIN tokens. Required in any deployment with more than one server
# process; without it each process uses a random secret and tokens do not work across processes.
TUTOR_PIN_SECRET=
